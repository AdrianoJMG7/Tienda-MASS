# Copia este archivo como .env (no se sube a Git) o define estas variables en el servicio (Render).
# En desarrollo no hace falta nada de esto: sin DB_HOST se usa SQLite y el correo sale por consola.
# No escribas contraseñas reales en este archivo de ejemplo.
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=mi-api.onrender.com
CORS_ALLOWED_ORIGINS=https://mi-frontend.example.com
CSRF_TRUSTED_ORIGINS=https://mi-api.onrender.com
FRONTEND_URL=https://mi-frontend.example.com

# PostgreSQL (Neon). Definir DB_HOST activa esta base en lugar de SQLite.
DB_HOST=servidor.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=usuario
DB_PASSWORD=contraseña
DB_SCHEMA=public
DB_SSLMODE=require

# Correo real (opcional).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.ejemplo.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
