# Copiar como variables de entorno del servicio al desplegar (Render, Railway...).
# En desarrollo no hace falta definir nada: se usan SQLite y el correo por consola.
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=mass-api.onrender.com
DATABASE_URL=postgresql://usuario:clave@servidor/mass
CORS_ALLOWED_ORIGINS=https://mass-propuesta.vercel.app
CSRF_TRUSTED_ORIGINS=https://mass-api.onrender.com
FRONTEND_URL=https://mass-propuesta.vercel.app
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.ejemplo.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
